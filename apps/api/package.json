{
	"name": "@afps/api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --watch --import tsx server.ts",
		"build": "prisma generate && tsc -p tsconfig.build.json",
		"start": "node dist/server.js",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"postinstall": "prisma generate",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:seed": "tsx prisma/seed.ts",
		"db:studio": "prisma studio"
	},
	"dependencies": {
		"@prisma/adapter-mariadb": "7.10.0",
		"@prisma/client": "^7.10.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-validator": "^7.3.2",
		"got": "^16.0.0",
		"helmet": "^8.3.0",
		"luxon": "^3.7.2",
		"stripe": "^22.6.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/luxon": "^3.7.5",
		"@types/node": "^22.20.1",
		"eslint": "^9",
		"prisma": "7.10.0",
		"tsx": "^4.23.13",
		"typescript": "^5",
		"typescript-eslint": "^8.69.0",
		"vitest": "^5.0.0"
	}
}
